<% content_for :head do %>
  <script type="application/ld+json"><%= raw({ "@context" => "https://schema.org", "@type" => "Person", name: "Antonio Smith", honorificSuffix: "MD, MBA",
    jobTitle: "Hospitalist Physician & Clinical Informatics Fellow", url: root_url, sameAs: [SITE.dig(:links, :linkedin), SITE.dig(:links, :github), SITE.dig(:links, :mastodon), SITE.dig(:links, :wiki)].compact,
    homeLocation: "Indianapolis, IN", affiliation: "Regenstrief Institute",
    knowsAbout: ["Clinical informatics", "Hospital medicine", "Healthcare AI", "Programming"] }.to_json) %></script>
<% end %>
<section class="hero">
  <p class="eyebrow">about</p>
  <h1><%= SITE[:name] %></h1>
  <p class="meta"><%= SITE[:tagline] %></p>
</section>
<% SITE[:intro].strip.split(/\n{2,}/).each do |para| %><p><%= para.squish %></p><% end %>
<p class="quiet-inline"><%= link_to "cv", SITE.dig(:links, :cv) %> · <%= link_to "linkedin", SITE.dig(:links, :linkedin), rel: "me" %> · <%= link_to "github", SITE.dig(:links, :github), rel: "me" %> · <%= link_to "mastodon", SITE.dig(:links, :mastodon), rel: "me" %> · <%= link_to "homelab wiki", SITE.dig(:links, :wiki) %></p>

<h2 class="section">Projects <span class="tag-r">*projects*</span></h2>
<% if @projects.any? || @repos.any? || SITE[:projects].present? %>
  <ul class="linklist">
    <% @projects.each do |p| %><li><%= link_to p.display_title, post_path(p) %> <span class="muted"><%= p.description.truncate(60) %></span></li><% end %>
    <% @repos.each do |r| %><li><%= link_to r.name, r.homepage || r.url %> <span class="muted"><%= r.description.to_s.truncate(60) %><%= " · #{r.language}" if r.language %></span></li><% end %>
    <% Array(SITE[:projects]).each do |pr| %><li><%= link_to pr[:name], pr[:url] %> <span class="muted"><%= pr[:description].to_s.truncate(60) %></span></li><% end %>
  </ul>
  <p><%= link_to "all projects →", projects_path, class: "more" %></p>
<% else %>
  <p class="muted">Coming soon.</p>
<% end %>

<h2 class="section">Writing <span class="tag-r">*writing*</span></h2>
<p class="muted">Articles, notes, and occasional observations on medicine, technology, and other subjects.</p>
<% if @writing.any? %>
  <ul class="linklist"><% @writing.each do |p| %><li><%= link_to p.display_title, post_path(p) %> <span class="muted"><%= p.published_at.strftime("%Y-%m-%d") %></span></li><% end %></ul>
  <p><%= link_to "all writing →", posts_path, class: "more" %></p>
<% else %>
  <p class="muted">First posts coming soon.</p>
<% end %>
