<% content_for :title, "Projects" %>
<% content_for :description, "Projects by #{SITE[:name]}: write-ups and open-source code." %>
<section class="hero"><p class="eyebrow">projects</p><h1>Projects</h1></section>

<% if @portfolio.any? %>
  <h2 class="section">Portfolio <span class="tag-r">*portfolio*</span></h2>
  <p class="muted">What I'm building and working on, updated automatically as the work moves.</p>
  <ul class="post-list portfolio">
  <% @portfolio.each do |pp| %>
    <li id="<%= pp.slug %>">
      <p class="meta">
        <span class="pf-status pf-<%= pp.status %>"><%= pp.status %></span><%= " · #{pp.stage}" if pp.stage.present? %><%= " · #{pp.domain}" if pp.domain.present? %>
        <% if pp.last_activity_at %> · updated <%= time_ago_in_words(pp.last_activity_at) %> ago<% end %>
      </p>
      <h2><%= pp.url.present? ? link_to(pp.name, pp.url, rel: "noopener") : pp.name %></h2>
      <% if pp.summary.present? %><p class="excerpt"><%= pp.summary %></p><% end %>
      <% if pp.stack_list.any? || pp.repo_url.present? %>
        <p class="repo-links">
          <% if pp.repo_url.present? %><%= link_to "code ↗", pp.repo_url, rel: "noopener" %><% end %>
          <% pp.stack_list.first(6).each do |t| %> <span class="repo-topic">*<%= t %>*</span><% end %>
        </p>
      <% end %>
      <% about = @graph.posts_about(pp) %>
      <% if about.any? %>
        <p class="pf-writing muted">written about in: <%= safe_join(about.first(4).map { link_to(_1.display_title, post_path(_1)) }, ", ") %>
          · <%= link_to "graph", graph_path(anchor: "pf:#{pp.slug}") %></p>
      <% end %>
    </li>
  <% end %>
  </ul>
<% end %>

<% if @projects.any? %>
  <h2 class="section">Write-ups <span class="tag-r">*write-ups*</span></h2>
  <ul class="post-list">
  <% @projects.each do |p| %>
    <li><p class="meta"><%= p.published_at.strftime("%Y-%m-%d") %></p><h2><%= link_to p.display_title, post_path(p) %></h2><p class="excerpt"><%= p.description %></p></li>
  <% end %>
  </ul>
<% end %>

<% if @repos.any? %>
  <h2 class="section">Code <span class="tag-r">*github*</span></h2>
  <ul class="post-list repos">
  <% @repos.each do |r| %>
    <li>
      <p class="meta">
        <% if r.language %><span class="lang"><%= r.language %></span> · <% end %>updated <%= r.pushed_at ? time_ago_in_words(r.pushed_at) + " ago" : "—" %><% if r.stars.to_i.positive? %> · ★ <%= r.stars %><% end %>
      </p>
      <h2><%= link_to r.name, r.url, rel: "noopener" %></h2>
      <% if r.description.present? %><p class="excerpt"><%= r.description %></p><% end %>
      <p class="repo-links">
        <%= link_to "code ↗", r.url, rel: "noopener" %>
        <% if r.homepage %> · <%= link_to "live ↗", r.homepage, rel: "noopener" %><% end %>
        <% r.topics.first(5).each do |t| %> <span class="repo-topic">*<%= t %>*</span><% end %>
      </p>
    </li>
  <% end %>
  </ul>
<% end %>

<% Array(SITE[:projects]).presence&.then do |pinned| %>
  <h2 class="section">Elsewhere <span class="tag-r">*elsewhere*</span></h2>
  <ul class="linklist">
    <% pinned.each do |pr| %><li><%= link_to pr[:name], pr[:url] %> <span class="muted"><%= pr[:description] %></span></li><% end %>
  </ul>
<% end %>

<% if @portfolio.empty? && @projects.empty? && @repos.empty? && SITE[:projects].blank? %><p class="muted">Coming soon.</p><% end %>
