<!DOCTYPE html>
<html lang="en">
<head>
  <% page_title = content_for?(:title) ? "#{yield(:title)} · #{SITE[:name]}" : "#{SITE[:name]} — #{SITE[:tagline]}" %>
  <% desc = yield(:description).presence || SITE[:intro].to_s.squish.truncate(155) %>
  <% canonical = content_for?(:canonical) ? yield(:canonical) : request.base_url + request.path %>
  <title><%= page_title %></title>
  <meta charset="utf-8">
  <script>(function(){try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}})()</script>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= desc %>">
  <meta name="author" content="<%= SITE[:name] %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:site_name" content="<%= SITE[:name] %>">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : SITE[:name] %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
  <meta name="twitter:card" content="summary">
  <%= yield :head %>
  <%= csrf_meta_tags %>
  <link rel="alternate" type="application/rss+xml" title="<%= SITE[:name] %>" href="<%= feed_url %>">
  <%= stylesheet_link_tag :app %>
</head>
<body>
<% if admin_signed_in? %>
  <div class="adminbar"><div class="wrap">
    <span>signed in</span>
    <% if @post&.persisted? %><%= link_to "edit this post", edit_admin_post_path(@post) %><% end %>
    <%= link_to "new post", new_admin_post_path %>
    <%= link_to "new project", new_admin_post_path(category: "projects") %>
    <%= link_to "admin", admin_root_path %>
  </div></div>
<% end %>
  <header class="site-header"><div class="wrap">
    <%= link_to SITE[:name], root_path, class: "brand" %>
    <nav><%= link_to "home", root_path %><%= link_to "blog", posts_path %><%= link_to "projects", projects_path %><%= link_to "graph", graph_path %><%= link_to "search", search_path %><%= link_to "cv", SITE.dig(:links,:cv) %><button class="theme-btn" type="button" title="Theme: auto / light / dark" onclick="(function(b){var o=['auto','light','dark'],d=document.documentElement,c=d.dataset.theme||'auto',n=o[(o.indexOf(c)+1)%3];if(n==='auto'){delete d.dataset.theme}else{d.dataset.theme=n}try{n==='auto'?localStorage.removeItem('theme'):localStorage.setItem('theme',n)}catch(e){}b.textContent='['+n+']'})(this)">[<span class="th-l">auto</span>]</button>
<script>(function(){var b=document.currentScript.previousElementSibling;b.textContent='['+(document.documentElement.dataset.theme||'auto')+']'})()</script></nav>
  </div></header>
  <% if flash.any? %><div class="wrap"><% flash.each do |k, m| %><p class="flash <%= k %>"><%= m %></p><% end %></div><% end %>
  <main class="wrap <%= yield(:main_class) %>"><%= yield %></main>
  <footer class="site-footer"><div class="wrap">
    <p>&copy; <%= Date.current.year %> <%= SITE[:name] %> · <%= link_to "rss", feed_path %> · <%= link_to "linkedin", SITE.dig(:links,:linkedin), rel: "me" %> · <%= link_to "github", SITE.dig(:links,:github), rel: "me" %></p>
  </div></footer>
</body>
</html>
