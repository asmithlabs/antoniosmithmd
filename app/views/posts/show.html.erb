<% content_for :title, @post.title %>
<% content_for :description, @post.description %>
<% content_for :og_type, "article" %>
<% content_for :main_class, "with-toc" if @post.toc.size >= 2 %>
<% content_for :head do %>
  <meta property="article:published_time" content="<%= @post.published_at.iso8601 %>">
  <meta property="article:modified_time" content="<%= @post.updated_or_published.iso8601 %>">
  <% if @post.category %><meta property="article:section" content="<%= @post.category_name %>"><% end %>
  <% @post.tag_list.each do |t| %><meta property="article:tag" content="<%= t %>"><% end %>
  <script type="application/ld+json"><%= raw({
    "@context" => "https://schema.org", "@type" => "BlogPosting",
    headline: @post.title, description: @post.description,
    datePublished: @post.published_at.iso8601, dateModified: @post.updated_or_published.iso8601,
    mainEntityOfPage: post_url(@post), url: post_url(@post),
    articleSection: @post.category_name, keywords: @post.tag_list.join(", "),
    wordCount: @post.plain_text.split.size,
    author: { "@type" => "Person", name: SITE[:name], url: root_url, sameAs: [SITE.dig(:links, :linkedin), SITE.dig(:links, :github)].compact },
    commentCount: @tree.values.flatten.size,
    citation: @post.cited_references.map { |r| { "@type" => "CreativeWork", name: r.title, author: r.authors.to_s.split(";").first&.strip, datePublished: r.year.presence, url: r.link }.compact }.presence
  }.compact.to_json) %></script>
<% end %>

<article class="post" data-mode="standard">
  <header>
    <p class="meta">
      <time datetime="<%= @post.published_at.iso8601 %>"><%= @post.published_at.strftime("%B %-d, %Y") %></time>
      · <%= @post.reading_minutes %> min read
      <% if @post.category %> · <%= link_to @post.category_name, category_path(@post.category) %><% end %>
      <% if @last_public_edit %> · <%= link_to "updated #{@last_public_edit.strftime("%B %-d, %Y")}", history_post_path(@post), title: "See how this post changed" %><% end %>
    </p>
    <h1><%= @post.display_title %></h1>
    <p class="reading-modes" role="group" aria-label="Reading mode" hidden>
      <span class="muted">view:</span>
      <button type="button" data-mode="focus" title="Just the text: no citation numbers, contents or side tools">focus</button>
      <button type="button" data-mode="standard" title="The default">standard</button>
      <button type="button" data-mode="study" title="Everything open: sources and supporting passages under each paragraph, reasoning and collapsibles expanded">study</button>
    </p>
    <% if @post.excerpt.present? %><p class="lede"><%= @post.excerpt %></p><% end %>
    <% if (fix = @changes.find { _1.change_kind == "correction" }) %>
      <p class="change-notice correction"><strong>Correction, <%= fix.created_at.strftime("%B %-d, %Y") %>:</strong> <%= fix.change_note %>
        <%= link_to "history", history_post_path(@post, anchor: "v#{fix.id}") %></p>
  <% end %>

    <% if (st = @post.stage_info) %>
      <p class="notebook-banner stage-<%= @post.notebook_stage %>"><span aria-hidden="true"><%= st[:icon] %></span>
        <strong>Working note · <%= st[:label].downcase %></strong> — <%= st[:blurb] %>.
        Last tended <time datetime="<%= @post.updated_at.iso8601 %>"><%= @post.updated_at.strftime("%B %-d, %Y") %></time>.
        <%= link_to "notebook", notebook_path %></p>
    <% end %>
  </header>

  <div class="post-grid">
  <% if @post.toc.size >= 2 %>
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-head"><span>CONTENTS</span><span class="tagname">*toc*</span></p>
      <ol>
        <% n = 0; m = 0 %>
        <% @post.toc.each do |h| %>
          <% if h[:level] == 2 then n += 1; m = 0; num = "#{n}." else m += 1; num = "#{n}.#{m}" end %>
          <li class="l<%= h[:level] %>"><a href="#<%= h[:id] %>"><span class="num"><%= num %></span><span class="t"><%= h[:text] %></span><span class="dots"></span><span class="ref">|<%= h[:id].truncate(22, omission: "") %>|</span></a></li>
        <% end %>
      </ol>
    </nav>
  <% end %>
  <div class="prose"><%= @post.rendered_html %></div>
  </div>

  <% if @changes.any? %>
    <h2 class="section" id="changes">Changes <span class="tag-r">*changes*</span></h2>
    <ul class="linklist changes">
      <% @changes.each do |c| %>
        <li><time datetime="<%= c.created_at.iso8601 %>"><%= c.created_at.strftime("%b %-d, %Y") %></time>
          <span class="change-kind <%= c.change_kind %>"><%= c.kind_label %></span> — <%= c.change_note %>
          <%= link_to "diff", history_post_path(@post, anchor: "v#{c.id}"), class: "muted" %></li>
      <% end %>
    </ul>
  <% end %>

  <% if (links = @post.code_link_list).any? %>
    <% repos = GithubProjects.cached.index_by { _1.full_name.downcase } %>
    <aside class="code-links" aria-labelledby="code-links-h">
      <p class="toc-head" id="code-links-h"><span>CODE &amp; PROJECT</span><span class="tagname">*code*</span></p>
      <ul>
        <% links.each do |l| %>
          <% live = l.kind == "repo" && repos[l.repo.to_s.downcase] %>
          <li><span class="cl-kind <%= l.kind %>"><%= l.kind_label %></span>
            <%= link_to l.label, l.url, rel: "noopener", target: "_blank" %>
            <% if live %><span class="muted"><%= [live.language, ("★ #{live.stars}" if live.stars.to_i.positive?), ("updated #{time_ago_in_words(live.pushed_at)} ago" if live.pushed_at)].compact.join(" · ") %></span><% end %>
          </li>
        <% end %>
      </ul>
  <% end %>

  <% if (qs = @post.question_list).any? %>
    <aside class="open-questions" aria-labelledby="oq-h">
      <p class="toc-head" id="oq-h"><span>OPEN QUESTIONS</span><span class="tagname">*questions*</span></p>
      <ul><% qs.each do |q| %><li><%= q %></li><% end %></ul>
      <% if @post.comments_open? %><p class="muted small">Have evidence or a lead? <a href="#comments">Leave a comment</a>.</p><% end %>
    </aside>
  <% end %>

  <% if @post.tag_list.any? %>
    <p class="tags">tags: <% @post.tag_list.each do |t| %><%= link_to t, tag_path(t) %> <% end %></p>
  <% end %>

  <% if @related.any? || @backlinks.any? || @post_projects.any? %>
    <h2 class="section">Connections <span class="tag-r">*connections*</span></h2>
    <ul class="linklist connections">
      <% @post_projects.each do |pp| %><li><%= link_to pp.name, projects_path(anchor: pp.slug) %> <span class="muted">project · <%= pp.status %></span></li><% end %>
      <% @related.each do |r, _score, why| %><li><%= link_to r.display_title, post_path(r) %> <span class="muted"><%= why %></span></li><% end %>
      <% (@backlinks - @related.map(&:first)).each do |b| %><li><%= link_to b.display_title, post_path(b) %> <span class="muted">links here</span></li><% end %>
    </ul>
    <p class="muted"><%= link_to "see it on the graph →", graph_path(anchor: "p:#{@post.slug}") %></p>
  <% end %>

  <% if @post.mastodon_url.present? && @post.mastodon_replies? %>
    <section class="fediverse" aria-labelledby="fedi-h">
      <h2 class="section" id="fedi-h">Replies on Mastodon <span class="tag-r">*fediverse*</span></h2>
      <p class="muted">This post was shared on Mastodon. Public replies there show up here;
        <%= link_to "reply on Mastodon ↗", @post.mastodon_url, rel: "noopener", target: "_blank" %> to join in.</p>
      <div id="fedi-replies" data-src="<%= fediverse_post_path(@post) %>"><p class="muted">Loading replies…</p></div>
      <script>
        (() => { const box = document.getElementById("fedi-replies")
          fetch(box.dataset.src, { headers: { Accept: "text/html" } }).then(r => r.ok ? r.text() : Promise.reject())
            .then(html => { box.innerHTML = html }).catch(() => { box.innerHTML = '<p class="muted">Couldn\'t load replies right now.</p>' }) })()
      </script>
    </section>
  <% end %>

  <%= render "comments/section", post: @post, tree: @tree %>
  <% counts = (@tree[nil] || []).select(&:anchored?).group_by(&:anchor).transform_values { |cs| { n: cs.size, first: "c#{cs.first.id}" } } %>
  <script type="application/json" id="para-data"><%= raw({ counts:, open: @post.comments_open? }.to_json.gsub("</", "<\\/")) %></script>
  <script>
  // Paragraph-level discussion: a ¶ button on each passage (with a count when it has comments).
  (() => {
    const data = JSON.parse(document.getElementById("para-data").textContent)
    const form = document.querySelector("#comments > .cform"), field = form?.querySelector(".anchor-field"), quote = form?.querySelector(".anchor-quote")
    const flash = el => { el.classList.add("para-flash"); setTimeout(() => el.classList.remove("para-flash"), 1600) }
    document.querySelectorAll(".prose [id^='para-']").forEach(p => {
      const c = data.counts[p.id]; if (!c && !(data.open && field)) return
      const text = p.textContent.trim()
      const tools = document.createElement("span"); tools.className = "para-tools" + (c ? " has" : "")
      if (c) {
        const b = Object.assign(document.createElement("a"), { href: "#" + c.first, className: "para-count", textContent: `¶ ${c.n}` })
        b.setAttribute("aria-label", `${c.n} comment${c.n === 1 ? "" : "s"} on this passage`); tools.append(b)
      }
      if (data.open && field) {
        const add = Object.assign(document.createElement("button"), { type: "button", className: "para-add", textContent: c ? "+" : "¶ +" })
        add.setAttribute("aria-label", "Comment on this passage"); add.title = "Comment on this passage"
        add.addEventListener("click", () => {
          field.value = p.id; quote.hidden = false
          quote.querySelector("q").textContent = text.length > 160 ? text.slice(0, 160) + "…" : text
          form.scrollIntoView({ behavior: "smooth", block: "center" }); form.querySelector("textarea").focus({ preventScroll: true })
        })
        tools.append(add)
      }
      p.append(" ", tools)
    })
    quote?.querySelector(".anchor-clear").addEventListener("click", () => { field.value = ""; quote.hidden = true })
    document.addEventListener("click", e => { const a = e.target.closest("a.to-passage"); if (a) { const t = document.querySelector(a.getAttribute("href")); if (t) setTimeout(() => flash(t), 50) } })
    if (location.hash.startsWith("#para-")) { const t = document.querySelector(location.hash); if (t) flash(t) }
  })()
  </script>
  <p class="back"><%= link_to "← all posts", posts_path %></p>
</article>
<script>
// Reading modes. focus = just the text; standard = as written; study = sources and reasoning laid open.
// Remembered per browser (?mode=study in a link overrides). Without JavaScript the post shows as standard.
(() => {
  const art = document.querySelector("article.post"), bar = art.querySelector(".reading-modes"), prose = art.querySelector(".prose")
  if (!bar || !prose) return
  const MODES = ["focus", "standard", "study"]
  const opened = new Set()
  function studyOn() {
    prose.querySelectorAll("details:not([open])").forEach(d => { d.open = true; opened.add(d) })
    // Under each passage, list the sources it cites, with any supporting passage.
    prose.querySelectorAll("p, li").forEach(el => {
      const cites = [...el.querySelectorAll(":scope a.cite")]; if (!cites.length || el.closest("ol.references")) return
      const box = document.createElement("div"); box.className = "study-sources"
      cites.forEach(a => {
        const ref = document.querySelector(a.getAttribute("href")); if (!ref) return
        const item = document.createElement("p")
        const n = Object.assign(document.createElement("a"), { href: a.getAttribute("href"), textContent: `[${a.textContent}] ` })
        const body = document.createElement("span"); body.innerHTML = (ref.querySelector(".ref-body") || ref).innerHTML
        item.append(n, body)
        if (a.dataset.evidence) item.append(Object.assign(document.createElement("q"), { className: "study-ev", textContent: a.dataset.evidence }))
        box.append(item)
      })
      if (box.childElementCount) el.after(box)
    })
  }
  function studyOff() {
    opened.forEach(d => { d.open = false }); opened.clear()
    prose.querySelectorAll(".study-sources").forEach(b => b.remove())
  }
  function set(mode, remember) {
    if (!MODES.includes(mode)) mode = "standard"
    if (art.dataset.mode === "study" && mode !== "study") studyOff()
    if (mode === "study" && art.dataset.mode !== "study") studyOn()
    art.dataset.mode = mode
    document.querySelector("main")?.classList.toggle("reading-focus", mode === "focus")
    bar.querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", b.dataset.mode === mode))
    if (remember) try { mode === "standard" ? localStorage.removeItem("readingMode") : localStorage.setItem("readingMode", mode) } catch {}
  }
  bar.hidden = false
  bar.addEventListener("click", e => { const b = e.target.closest("button[data-mode]"); if (b) set(b.dataset.mode, true) })
  let start = new URLSearchParams(location.search).get("mode")
  if (!start) try { start = localStorage.getItem("readingMode") } catch {}
  // Run after the other post scripts (citation cards, passage tools) have set up.
  requestAnimationFrame(() => set(start || "standard", false))
})()
</script>
<script>
(() => {
  const links = [...document.querySelectorAll(".toc a")]; if (!links.length) return
  const map = new Map(links.map(a => [a.getAttribute("href").slice(1), a]))
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { links.forEach(l => l.classList.remove("active")); map.get(e.target.id)?.classList.add("active") } }), { rootMargin: "0px 0px -70% 0px" })
  map.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h) })
})()
</script>
<script>
// Citation cards: hover / keyboard focus / tap on [n] shows the full reference.
(() => {
  const cites = document.querySelectorAll(".prose a.cite"); if (!cites.length) return
  const card = document.createElement("div"); card.className = "cite-card"; card.setAttribute("role", "tooltip"); card.hidden = true
  document.body.append(card)
  let hideT, current
  const show = a => {
    const li = document.querySelector(a.getAttribute("href")); if (!li) return
    clearTimeout(hideT); current = a
    const body = li.querySelector(".ref-body")?.innerHTML || li.innerHTML
    const link = li.querySelector(".ref-link")
    const n = a.getAttribute("href").replace("#ref-", "")
    const ev = a.dataset.evidence ? Object.assign(document.createElement("blockquote"), { className: "cc-evidence", textContent: a.dataset.evidence }).outerHTML : ""
    const loc = a.textContent.match(/\((.+)\)/)?.[1]
    const evNote = ev ? `<p class="cc-evidence-note">Supporting passage${loc ? ` (${loc.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c])})` : ""}</p>` : ""
    card.innerHTML = `<p class="cc-n">[${n}]</p>${ev}${evNote}<p>${body}</p><p class="cc-actions">${link ? `<a href="${link.href}" target="_blank" rel="noopener">open source ↗</a> · ` : ""}<a href="#ref-${n}">jump to reference list</a></p>`
    card.hidden = false
    const r = a.getBoundingClientRect(), w = Math.min(420, innerWidth - 16)
    card.style.width = w + "px"
    card.style.left = Math.max(8, Math.min(r.left + scrollX - 20, scrollX + innerWidth - w - 8)) + "px"
    const below = r.bottom + scrollY + 8, above = r.top + scrollY - card.offsetHeight - 8
    card.style.top = (r.bottom + card.offsetHeight + 16 > innerHeight && above > scrollY ? above : below) + "px"
    a.setAttribute("aria-describedby", "cite-card")
  }
  const hide = () => { hideT = setTimeout(() => { card.hidden = true; current = null }, 200) }
  card.id = "cite-card"
  card.addEventListener("mouseenter", () => clearTimeout(hideT)); card.addEventListener("mouseleave", hide)
  cites.forEach(a => {
    a.addEventListener("mouseenter", () => show(a)); a.addEventListener("mouseleave", hide)
    a.addEventListener("focus", () => show(a)); a.addEventListener("blur", hide)
    a.addEventListener("click", e => { if (matchMedia("(hover: none)").matches && current !== a) { e.preventDefault(); show(a) } })   // phones: first tap shows the card
  })
  document.addEventListener("keydown", e => { if (e.key === "Escape") card.hidden = true })
  document.addEventListener("click", e => { if (!card.hidden && !card.contains(e.target) && !e.target.closest("a.cite")) card.hidden = true })
})()
</script>
