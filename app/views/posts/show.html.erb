<% content_for :title, @post.title %>
<% content_for :description, @post.description %>
<% content_for :og_type, "article" %>
<% content_for :main_class, "with-toc" if @post.toc.size >= 2 %>
<% content_for :head do %>
  <meta property="article:published_time" content="<%= @post.published_at.iso8601 %>">
  <meta property="article:modified_time" content="<%= @post.updated_or_published.iso8601 %>">
  <% if @post.category %><meta property="article:section" content="<%= @post.category_name %>"><% end %>
  <% @post.tag_list.each do |t| %><meta property="article:tag" content="<%= t %>"><% end %>
  <script type="application/ld+json"><%= raw({
    "@context" => "https://schema.org", "@type" => "BlogPosting",
    headline: @post.title, description: @post.description,
    datePublished: @post.published_at.iso8601, dateModified: @post.updated_or_published.iso8601,
    mainEntityOfPage: post_url(@post), url: post_url(@post),
    articleSection: @post.category_name, keywords: @post.tag_list.join(", "),
    wordCount: @post.plain_text.split.size,
    author: { "@type" => "Person", name: SITE[:name], url: root_url, sameAs: [SITE.dig(:links, :linkedin), SITE.dig(:links, :github)].compact },
    commentCount: @tree.values.flatten.size,
    citation: @post.cited_references.map { |r| { "@type" => "CreativeWork", name: r.title, author: r.authors.to_s.split(";").first&.strip, datePublished: r.year.presence, url: r.link }.compact }.presence
  }.compact.to_json) %></script>
<% end %>

<article class="post">
  <header>
    <p class="meta">
      <time datetime="<%= @post.published_at.iso8601 %>"><%= @post.published_at.strftime("%B %-d, %Y") %></time>
      · <%= @post.reading_minutes %> min read
      <% if @post.category %> · <%= link_to @post.category_name, category_path(@post.category) %><% end %>
    </p>
    <h1><%= @post.display_title %></h1>
    <% if @post.excerpt.present? %><p class="lede"><%= @post.excerpt %></p><% end %>
  </header>

  <div class="post-grid">
  <% if @post.toc.size >= 2 %>
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-head"><span>CONTENTS</span><span class="tagname">*toc*</span></p>
      <ol>
        <% n = 0; m = 0 %>
        <% @post.toc.each do |h| %>
          <% if h[:level] == 2 then n += 1; m = 0; num = "#{n}." else m += 1; num = "#{n}.#{m}" end %>
          <li class="l<%= h[:level] %>"><a href="#<%= h[:id] %>"><span class="num"><%= num %></span><span class="t"><%= h[:text] %></span><span class="dots"></span><span class="ref">|<%= h[:id].truncate(22, omission: "") %>|</span></a></li>
        <% end %>
      </ol>
    </nav>
  <% end %>
  <div class="prose"><%= @post.rendered_html %></div>
  </div>

  <% if @post.tag_list.any? %>
    <p class="tags">tags: <% @post.tag_list.each do |t| %><%= link_to t, tag_path(t) %> <% end %></p>
  <% end %>

  <% if @related.any? || @backlinks.any? %>
    <h2 class="section">Connections <span class="tag-r">*connections*</span></h2>
    <ul class="linklist connections">
      <% @related.each do |r, _score, why| %><li><%= link_to r.display_title, post_path(r) %> <span class="muted"><%= why %></span></li><% end %>
      <% (@backlinks - @related.map(&:first)).each do |b| %><li><%= link_to b.display_title, post_path(b) %> <span class="muted">links here</span></li><% end %>
    </ul>
    <p class="muted"><%= link_to "see it on the graph →", graph_path(anchor: "p:#{@post.slug}") %></p>
  <% end %>

  <%= render "comments/section", post: @post, tree: @tree %>
  <p class="back"><%= link_to "← all posts", posts_path %></p>
</article>
<script>
(() => {
  const links = [...document.querySelectorAll(".toc a")]; if (!links.length) return
  const map = new Map(links.map(a => [a.getAttribute("href").slice(1), a]))
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { links.forEach(l => l.classList.remove("active")); map.get(e.target.id)?.classList.add("active") } }), { rootMargin: "0px 0px -70% 0px" })
  map.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h) })
})()
</script>
<script>
// Citation cards: hover / keyboard focus / tap on [n] shows the full reference.
(() => {
  const cites = document.querySelectorAll(".prose a.cite"); if (!cites.length) return
  const card = document.createElement("div"); card.className = "cite-card"; card.setAttribute("role", "tooltip"); card.hidden = true
  document.body.append(card)
  let hideT, current
  const show = a => {
    const li = document.querySelector(a.getAttribute("href")); if (!li) return
    clearTimeout(hideT); current = a
    const body = li.querySelector(".ref-body")?.innerHTML || li.innerHTML
    const link = li.querySelector(".ref-link")
    const n = a.getAttribute("href").replace("#ref-", "")
    card.innerHTML = `<p class="cc-n">[${n}]</p><p>${body}</p><p class="cc-actions">${link ? `<a href="${link.href}" target="_blank" rel="noopener">open source ↗</a> · ` : ""}<a href="#ref-${n}">jump to reference list</a></p>`
    card.hidden = false
    const r = a.getBoundingClientRect(), w = Math.min(420, innerWidth - 16)
    card.style.width = w + "px"
    card.style.left = Math.max(8, Math.min(r.left + scrollX - 20, scrollX + innerWidth - w - 8)) + "px"
    const below = r.bottom + scrollY + 8, above = r.top + scrollY - card.offsetHeight - 8
    card.style.top = (r.bottom + card.offsetHeight + 16 > innerHeight && above > scrollY ? above : below) + "px"
    a.setAttribute("aria-describedby", "cite-card")
  }
  const hide = () => { hideT = setTimeout(() => { card.hidden = true; current = null }, 200) }
  card.id = "cite-card"
  card.addEventListener("mouseenter", () => clearTimeout(hideT)); card.addEventListener("mouseleave", hide)
  cites.forEach(a => {
    a.addEventListener("mouseenter", () => show(a)); a.addEventListener("mouseleave", hide)
    a.addEventListener("focus", () => show(a)); a.addEventListener("blur", hide)
    a.addEventListener("click", e => { if (matchMedia("(hover: none)").matches && current !== a) { e.preventDefault(); show(a) } })   // phones: first tap shows the card
  })
  document.addEventListener("keydown", e => { if (e.key === "Escape") card.hidden = true })
  document.addEventListener("click", e => { if (!card.hidden && !card.contains(e.target) && !e.target.closest("a.cite")) card.hidden = true })
})()
</script>
